# ---------------------------------------------------------------
# BlogFlow CMS - Apache configuration for the /blogs/ directory.
# This file only affects this directory; the main website is untouched.
# ---------------------------------------------------------------

Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    # If the blog lives in an aliased or unusual path and URLs 404, set the
    # installation path explicitly, e.g.:
    # RewriteBase /blogs/

    # Never serve private application files.
    RewriteRule ^(app|config|database|storage|vendor|bin|tests)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^(composer\.(json|lock)|[^/]+\.(md|sql|log|dist|sample|lock|ini|sh))$ - [F,L,NC]

    # Pass Authorization headers to PHP (some CGI/FastCGI hosts drop them).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Send everything that is not a real file or directory to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
    # Clean URLs require mod_rewrite. Ask your host to enable it.
    ErrorDocument 404 "BlogFlow CMS needs Apache mod_rewrite to be enabled."
</IfModule>

# Protect sensitive file types anywhere below this directory.
<FilesMatch "(?i)(^\.|\.(sql|log|md|lock|ini|sh|dist|sample|bak|swp)$|^composer\.json$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/rss+xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/webp .webp
    AddType image/avif .avif
</IfModule>
