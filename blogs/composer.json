{
  "name": "blogflow/cms",
  "description": "BlogFlow CMS - a standalone, reusable PHP blog CMS that installs into a /blogs/ subdirectory.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "ext-json": "*",
    "ext-dom": "*",
    "ezyang/htmlpurifier": "^4.19",
    "phpmailer/phpmailer": "^6.10 || ^7.0"
  },
  "autoload": {
    "psr-4": { "BlogFlow\\": "app/" }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": { "php": "8.2.0" }
  }
}
